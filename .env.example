PORT=3000
NODE_ENV=development

POSTGRES_USER=cms_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=cms_db
DATABASE_URL=postgresql://cms_user:change-this-local-password@localhost:5432/cms_db?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880